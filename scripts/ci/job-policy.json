{
  "jobs": [
    "infrastructure",
    "website",
    "website-quality",
    "lint",
    "build",
    "test"
  ],
  "rules": [
    { "prefix": "packages/website/", "jobs": ["website", "website-quality"] },
    {
      "prefix": "burrowd/",
      "jobs": ["infrastructure", "lint", "build", "test"]
    },
    {
      "prefix": "burrowctl/",
      "jobs": ["infrastructure", "lint", "build", "test"]
    },
    {
      "prefix": "protocol/",
      "jobs": ["infrastructure", "lint", "build", "test"]
    },
    { "prefix": "infra/", "jobs": ["infrastructure"] }
  ]
}
