{
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "package.json",
        "packages/burrowctl/package.json",
        "packages/burrowctl-linux-x64/package.json",
        "packages/burrowctl-linux-arm64/package.json",
        "packages/burrowctl-darwin-x64/package.json",
        "packages/burrowctl-darwin-arm64/package.json",
        "burrowd/version.go",
        "burrowctl/version.go"
      ],
      "versioning": "default",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
