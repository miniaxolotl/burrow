# The website's public origin, not the burrowd tunnel server.
# Set this before building for correct canonical URLs and social sharing.
# Production: https://useburrow.app
SITE_URL=http://localhost:3000

# Set true on non-Vercel staging deployments. Vercel previews are always noindex.
SITE_NOINDEX=false
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_DSN=
# Build-only source-map credential; never NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=
