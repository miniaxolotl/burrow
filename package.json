{
  "name": "@monorepo/burrow",
  "private": true,
  "version": "0.2.7",
  "description": "Network tunneling service",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/burrow.git"
  },
  "homepage": "https://github.com/miniaxolotl/burrow#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter website dev",
    "build:website": "pnpm --filter website build",
    "start:website": "pnpm --filter website start",
    "lint:website": "pnpm --filter website lint",
    "typecheck:website": "pnpm --filter website typecheck",
    "release": "pnpm --filter @script/release run release",
    "deploy": "pnpm --filter @script/deploy run deploy",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "clean": "rm -rf packages/*/dist packages/*/.next packages/*/*.tsbuildinfo scripts/*/dist node_modules"
  },
  "devDependencies": {
    "@types/node": "~25.5.0",
    "prettier": "~3.8.1"
  }
}
