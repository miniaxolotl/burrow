#-- Server (burrowd)
BURROW_DOMAIN=localhost
BURROW_PORT=25701
BURROW_TLS=false
BURROW_TELEMETRY_ENABLED=false

#-- Client (burrowctl)
BURROW_SERVER=brmbl.dev
# Optional process-wide opt-out, including official CLI releases:
# BURROW_TELEMETRY=0
# DO_NOT_TRACK=1

#-- Database (redis)
BURROW_REDIS_URL=redis://redis:6379
