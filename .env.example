# Authentication secret — used to sign and verify tokens.
# Generate one with: openssl rand -hex 32
BURROW_SECRET=

# Domain for tunnel URLs. Wildcard DNS must point to your Pi's public IP:
#   *.inkspire.app -> <your-public-ip>
#    inkspire.app  -> <your-public-ip>
BURROW_DOMAIN=inkspire.app

# Internal port burrowd listens on (nginx proxies to this; bound to 127.0.0.1 only).
BURROW_PORT=25701

# Redis connection URL (leave as-is when using docker-compose).
BURROW_REDIS_URL=redis://redis:6379
